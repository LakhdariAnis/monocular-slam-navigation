# Copy to .env (gitignored) and set your own values:  cp .env.example .env
# docker compose reads this file automatically; launch.py passes it to the Python scripts.
# InfluxDB only applies these on FIRST start (empty influxdb/data/). Changing them later
# does not change the token of an existing database.
INFLUXDB_ADMIN_PASSWORD=change-me
INFLUXDB_TOKEN=change-me
